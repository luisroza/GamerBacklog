@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="max-w-md mx-auto card p-8">
    <h1 class="font-display text-2xl font-bold">Sign in</h1>
    <p class="text-dim text-sm mt-1">Welcome back!</p>

    <div class="mt-4 rounded-xl border border-edge bg-elevated p-3 text-xs text-dim">
        Demo account: <span class="text-ink font-semibold">demo&#64;GamerBacklog.dev</span> · password <span class="text-ink font-semibold">Demo123!</span>
    </div>

    <form method="post" class="mt-6 space-y-4">
        <div asp-validation-summary="All" class="text-rose-400 text-sm"></div>
        <div>
            <label asp-for="Login" class="label"></label>
            <input asp-for="Login" class="input" placeholder="demo@GamerBacklog.dev or demo" />
        </div>
        <div>
            <label asp-for="Password" class="label"></label>
            <input asp-for="Password" type="password" class="input" />
        </div>
        <label class="flex items-center gap-2 text-sm text-dim">
            <input asp-for="RememberMe" class="accent-accent" />
            <span>Keep me signed in</span>
        </label>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit" class="btn-primary w-full justify-center">Sign in</button>
    </form>

    <p class="mt-4 text-sm text-dim">Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-accent hover:underline">Sign up</a></p>
</div>
