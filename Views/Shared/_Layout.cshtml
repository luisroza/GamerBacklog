@using Microsoft.AspNetCore.Identity
@inject INotificationService Notifications
@inject UserManager<ApplicationUser> UserManager
@{
    var authed = User.Identity?.IsAuthenticated == true;
    ApplicationUser? me = null;
    var unread = 0;
    List<Notification> latest = new();
    if (authed)
    {
        me = await UserManager.GetUserAsync(User);
        if (me != null)
        {
            unread = await Notifications.GetUnreadCountAsync(me.Id);
            latest = await Notifications.GetLatestAsync(me.Id, 8);
        }
    }
    var flash = TempData["Flash"] as string;
    var userName = me?.UserName ?? "user";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:," />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · GamerBacklog" : "GamerBacklog")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        coal: '#0F1115',
                        surface: '#1A1D23',
                        elevated: '#23272F',
                        edge: '#2E333D',
                        ink: '#E5E7EB',
                        dim: '#9CA3AF',
                        accent: '#2DD4BF',
                        accent2: '#14B8A6',
                        gold: '#FBBF24'
                    },
                    fontFamily: {
                        display: ['Outfit', 'sans-serif'],
                        body: ['Inter', 'sans-serif']
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-coal text-ink font-body min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-edge bg-coal/80 backdrop-blur">
        <div class="mx-auto max-w-7xl px-4 h-16 flex items-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="font-display text-xl font-extrabold tracking-tight shrink-0">
                <span class="text-accent">G</span>amerBacklog
            </a>

            <form asp-controller="Games" asp-action="Index" method="get" class="hidden md:block flex-1 max-w-md">
                <input type="search" name="q" placeholder="Search games..." class="input py-2 text-sm" />
            </form>

            <nav class="hidden md:flex items-center gap-1 text-sm ml-2">
                <a asp-controller="Games" asp-action="Index" class="navlink">Games</a>
                @if (authed)
                {
                    <a asp-controller="Library" asp-action="Index" class="navlink">Library</a>
                }
            </nav>

            <div class="ml-auto flex items-center gap-2">
                @if (authed && me != null)
                {
                    <details class="relative">
                        <summary class="relative flex items-center p-2 rounded-full hover:bg-surface" aria-label="Notifications">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-dim"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                            @if (unread > 0)
                            {
                                <span class="absolute top-0.5 right-0 bg-accent text-coal text-[10px] font-bold rounded-full min-w-[1rem] h-4 px-1 flex items-center justify-center">@unread</span>
                            }
                        </summary>
                        <div class="absolute right-0 mt-2 w-80 card p-2 shadow-2xl">
                            <div class="flex items-center justify-between px-2 py-1">
                                <span class="text-[11px] font-bold uppercase tracking-wide text-dim">Notifications</span>
                                <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                                    <button type="submit" class="text-xs text-accent hover:underline">mark read</button>
                                </form>
                            </div>
                            @if (latest.Count == 0)
                            {
                                <div class="px-3 py-4 text-sm text-dim">No notifications yet.</div>
                            }
                            else
                            {
                                @foreach (var n in latest)
                                {
                                    <a href="@n.Link" class="block px-3 py-2 rounded-lg text-sm hover:bg-surface @(n.IsRead ? "text-dim" : "text-ink")">
                                        @n.Text
                                        <span class="block text-xs text-dim mt-0.5">@Ui.TimeAgo(n.CreatedAt)</span>
                                    </a>
                                }
                            }
                        </div>
                    </details>

                    <details class="relative">
                        <summary class="flex items-center rounded-full" aria-label="User menu">
                            <img src="@(me.AvatarUrl ?? "/avatar/" + Uri.EscapeDataString(userName))" alt="@userName" class="w-9 h-9 rounded-full border border-edge" />
                        </summary>
                        <div class="absolute right-0 mt-2 w-48 card p-2 shadow-2xl">
                            <a class="menu-item" href="/u/@Uri.EscapeDataString(userName)">My profile</a>
                            <a class="menu-item" asp-controller="Library" asp-action="Index">My library</a>
                            <a class="menu-item" asp-controller="Settings" asp-action="Integrations">Integrations</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="menu-item w-full text-left text-rose-400 hover:text-rose-300">Sign out</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="navlink">Sign in</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-primary !py-2 text-sm">Create account</a>
                }

                <details class="relative md:hidden">
                    <summary class="flex items-center p-2 rounded-lg hover:bg-surface" aria-label="Menu">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-dim"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                    </summary>
                    <div class="absolute right-0 mt-2 w-56 card p-2 shadow-2xl">
                        <form asp-controller="Games" asp-action="Index" method="get" class="p-2">
                            <input type="search" name="q" placeholder="Search games..." class="input text-sm" />
                        </form>
                        <a class="menu-item" asp-controller="Games" asp-action="Index">Games</a>
                        @if (authed)
                        {
                            <a class="menu-item" asp-controller="Library" asp-action="Index">Library</a>
                            <a class="menu-item" asp-controller="Settings" asp-action="Integrations">Integrations</a>
                        }
                        else
                        {
                            <a class="menu-item" asp-controller="Account" asp-action="Login">Sign in</a>
                            <a class="menu-item" asp-controller="Account" asp-action="Register">Create account</a>
                        }
                    </div>
                </details>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(flash))
    {
        <div class="mx-auto max-w-7xl px-4 mt-4 w-full">
            <div class="rounded-xl border border-accent/30 bg-accent/10 text-accent px-4 py-3 text-sm">@flash</div>
        </div>
    }

    <main class="flex-1 w-full mx-auto max-w-7xl px-4 py-8">
        @RenderBody()
    </main>

    <footer class="border-t border-edge py-6">
        <div class="mx-auto max-w-7xl px-4 text-sm text-dim flex flex-col sm:flex-row items-center justify-between gap-2">
            <span><span class="text-accent font-bold">G</span>amerBacklog — MVP demo</span>
            <span>Catalog and integrations running in demo mode.</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
