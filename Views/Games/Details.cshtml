@model GameDetailsViewModel
@{
    ViewData["Title"] = Model.Game.Name;
    var currentStatus = Model.Existing?.Status;
    var roundedAvg = (int)Math.Round(Model.AverageRating ?? 0);
}

<div class="relative overflow-hidden rounded-3xl border border-edge bg-surface">
    <div class="banner absolute inset-0 opacity-30"></div>
    <div class="relative p-6 md:p-10 flex flex-col md:flex-row gap-8">
        <img src="@(Model.Game.ImageUrl ?? Model.Game.CoverUrl)" alt="@Model.Game.Name" class="w-40 md:w-48 rounded-xl border border-edge object-cover aspect-[2/3] shrink-0 shadow-2xl" onerror="this.onerror=null;this.src='@Model.Game.CoverUrl'" />
        <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
                @if (Model.Game.ReleaseYear != null)
                {
                    <span class="pill pill-playing">@Model.Game.ReleaseYear</span>
                }
                @if (Model.Game.Metacritic != null)
                {
                    var mc = Model.Game.Metacritic.Value;
                    <span class="text-xs font-extrabold px-2 py-1 rounded-md @(mc >= 75 ? "bg-emerald-500" : mc >= 50 ? "bg-amber-500" : "bg-rose-500") text-coal" title="Metacritic">Metacritic @mc</span>
                }
                @foreach (var g in Model.Game.Genres.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <a asp-controller="Games" asp-action="Index" asp-route-genre="@g" class="text-xs px-2.5 py-1 rounded-full border border-edge bg-elevated text-dim hover:text-accent hover:border-accent">@g</a>
                }
            </div>
            <h1 class="mt-3 font-display text-3xl md:text-4xl font-extrabold">@Model.Game.Name</h1>
            <p class="mt-1 text-sm text-dim">@Model.Game.Developer</p>
            <p class="mt-4 text-sm md:text-base text-ink max-w-3xl">@Model.Game.Summary</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
                @foreach (var p in Model.Game.Platforms.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <span class="text-xs px-2 py-1 rounded-md border border-edge bg-elevated text-dim">@p</span>
                }
            </div>
            <div class="mt-5 flex items-center gap-3">
                <span class="font-display text-3xl font-extrabold text-gold">@(Model.AverageRating?.ToString("0.0") ?? "—")</span>
                <div>
                    <div class="text-lg leading-none"><span class="text-gold">@(new string('★', roundedAvg))</span><span class="text-edge">@(new string('★', 5 - roundedAvg))</span></div>
                    <span class="text-xs text-dim">@Model.RatingCount @(Model.RatingCount == 1 ? "rating" : "ratings")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-8 grid gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2 space-y-8">
        @if (Model.IsLoggedIn)
        {
            <section class="card p-6">
                <h2 class="font-display text-lg font-bold">Your status</h2>
                <div class="mt-4 flex flex-wrap gap-2">
                    @foreach (PlayStatus s in Enum.GetValues(typeof(PlayStatus)))
                    {
                        var isCurrent = currentStatus == s;
                        <form method="post" asp-action="SetStatus" asp-route-id="@Model.Game.Id" class="inline">
                            <input type="hidden" name="status" value="@((int)s)" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="@(isCurrent ? s.PillClass() + " px-4 py-2 text-sm" : "btn-status")">@s.Label()</button>
                        </form>
                    }
                </div>
                @if (Model.Existing != null && Model.Existing.HoursPlayed != null)
                {
                    <p class="mt-3 text-xs text-dim">Time played: @Model.Existing.HoursPlayed h</p>
                }
            </section>

            <section class="card p-6">
                <h2 class="font-display text-lg font-bold">Your rating</h2>
                <form method="post" asp-action="SaveReview" asp-route-id="@Model.Game.Id" class="mt-4">
                    <div class="flex items-center gap-3">
                        <div id="starInput" data-value="@(Model.Existing?.Rating ?? 0)" class="flex text-3xl leading-none select-none">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <button type="button" class="star-btn" data-star="@i" aria-label="@i star(s)">★</button>
                            }
                        </div>
                        <span id="starLabel" class="text-sm text-dim"></span>
                    </div>
                    <input type="hidden" name="rating" id="ratingValue" value="@Model.Existing?.Rating" />
                    <textarea name="review" rows="4" class="input mt-4" placeholder="Write your review (optional)...">@Model.Existing?.Review</textarea>
                    <div class="mt-4 flex justify-end">
                        <button type="submit" class="btn-primary">Save rating</button>
                    </div>
                </form>
            </section>
        }
        else
        {
            <section class="card p-6 text-center">
                <p class="text-dim text-sm">Sign in to set your status, rate games and write reviews.</p>
                <div class="mt-4 flex gap-2 justify-center">
                    <a asp-controller="Account" asp-action="Login" class="btn-primary">Sign in</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-outline">Create account</a>
                </div>
            </section>
        }

        @if (Model.Achievements.Count > 0)
        {
            <section>
                <h2 class="font-display text-xl font-bold">Achievements <span class="text-dim text-sm font-normal">(@Model.Achievements.Count)</span></h2>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                    @foreach (var a in Model.Achievements)
                    {
                        var unlocked = Model.UnlockedIds.Contains(a.Id);
                        <div class="card p-4 flex gap-3 @(unlocked ? "border-accent/40" : "")">
                            <div class="w-10 h-10 rounded-lg bg-elevated border border-edge flex items-center justify-center shrink-0 @(unlocked ? "text-gold" : "text-dim")">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.5 13 17 22l-5-3-5 3 1.5-9"/></svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-2">
                                    <h3 class="text-sm font-semibold truncate">@a.Name</h3>
                                    @if (unlocked)
                                    {
                                        <span class="pill pill-played">Unlocked</span>
                                    }
                                </div>
                                <p class="text-xs text-dim mt-0.5">@a.Description</p>
                                <div class="rating-bar mt-2"><div style="width:@a.RarityPercent.ToString("0")%"></div></div>
                                <p class="text-[11px] text-dim mt-1">@(a.RarityPercent.ToString("0"))% of players</p>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <section>
            <h2 class="font-display text-xl font-bold">Reviews <span class="text-dim text-sm font-normal">(@Model.Reviews.Count)</span></h2>
            @if (Model.Reviews.Count == 0)
            {
                <div class="card p-6 mt-4 text-sm text-dim">No reviews yet. Be the first!</div>
            }
            <div class="mt-4 space-y-3">
                @foreach (var r in Model.Reviews)
                {
                    <div class="card p-5">
                        <div class="flex items-center gap-3">
                            <img src="/avatar/@Uri.EscapeDataString(r.UserName)" alt="" class="w-9 h-9 rounded-full border border-edge" />
                            <div>
                                <a href="/u/@Uri.EscapeDataString(r.UserName)" class="text-sm font-semibold hover:text-accent">@r.DisplayName</a>
                                <div class="text-xs text-dim">@Ui.TimeAgo(r.UpdatedAt)</div>
                            </div>
                            <div class="ml-auto text-sm">
                                @if (r.Rating != null)
                                {
                                    <span class="text-gold">@(new string('★', r.Rating.Value))</span><span class="text-edge">@(new string('★', 5 - r.Rating.Value))</span>
                                }
                            </div>
                        </div>
                        <p class="mt-3 text-sm text-ink whitespace-pre-line">@r.Review</p>
                    </div>
                }
            </div>
        </section>
    </div>

    <aside class="space-y-6">
        <div class="card p-6">
            <h3 class="font-display text-lg font-bold">Details</h3>
            <dl class="mt-4 space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-dim">Developer</dt><dd class="text-right">@Model.Game.Developer</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-dim">Release</dt><dd>@(Model.Game.ReleaseYear != null ? Model.Game.ReleaseYear.ToString() : "—")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-dim">Genres</dt><dd class="text-right">@Model.Game.Genres</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-dim">Platforms</dt><dd class="text-right">@Model.Game.Platforms</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-dim">Metacritic</dt><dd>@(Model.Game.Metacritic != null ? Model.Game.Metacritic.ToString() : "—")</dd></div>
            </dl>
        </div>
        <div class="card p-6">
            <h3 class="font-display text-lg font-bold">Community</h3>
            <p class="mt-3 text-sm text-dim">Overall average: <span class="text-gold font-bold">@(Model.AverageRating?.ToString("0.0") ?? "—")</span> with @Model.RatingCount @(Model.RatingCount == 1 ? "vote" : "votes").</p>
        </div>
    </aside>
</div>

@section Scripts {
    <script>
        (function () {
            var wrap = document.getElementById('starInput');
            if (!wrap) return;
            var hidden = document.getElementById('ratingValue');
            var label = document.getElementById('starLabel');
            var btns = Array.prototype.slice.call(wrap.querySelectorAll('.star-btn'));
            var current = parseInt(wrap.getAttribute('data-value') || '0', 10) || 0;

            function paint(v) {
                btns.forEach(function (b) {
                    var on = parseInt(b.getAttribute('data-star'), 10) <= v;
                    b.classList.toggle('star-on', on);
                });
                if (label) label.textContent = v > 0 ? (v + ' of 5 stars') : 'No rating';
            }

            btns.forEach(function (b) {
                b.addEventListener('click', function () {
                    var v = parseInt(b.getAttribute('data-star'), 10);
                    current = (v === current) ? 0 : v;
                    if (hidden) hidden.value = current > 0 ? String(current) : '';
                    paint(current);
                });
            });

            paint(current);
        })();
    </script>
}
